# ==========================================================================
# MedStudy — Variables d'environnement de production (Vercel + Supabase)
# Copiez ce fichier en .env.local pour les tests locaux Node/Vercel.
# NE COMMITEZ JAMAIS .env.local ni de vraies clés sur GitHub !
# ==========================================================================

# 1. URL de votre projet Supabase (Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# 2. Clé publique anon Supabase (Project Settings -> API -> anon public)
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# 3. Clé secrète service_role Supabase (SERVEUR UNIQUEMENT — ne jamais préfixer par NEXT_PUBLIC_ ou exposer au client)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# 4. Optionnel — Nom du bucket privé Supabase Storage (par défaut : medstudy-files)
SUPABASE_STORAGE_BUCKET=medstudy-files

# 5. Optionnel — Compte Administrateur initial utilisé uniquement par scripts/migrate-to-supabase.mjs
ADMIN_SEED_EMAIL=admin@votredomaine.com
ADMIN_SEED_PASSWORD=CHANGEZ_CE_MOT_DE_PASSE_FORT
ADMIN_SEED_NAME=Propriétaire MedStudy (Admin)

# 6. Optionnel — Clé API IA côté serveur (si vous activez un moteur IA externe plus tard)
AI_PROVIDER=local
AI_API_KEY=
